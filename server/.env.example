# PulseCare Backend Environment Configuration Template
PORT=5000

# Database Connection:
# Option A: MongoDB Atlas (Cloud) - replace <username>, <password>, and <cluster-url>
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/book_a_doctor?retryWrites=true&w=majority
#
# Option B: Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/book_a_doctor

# JWT secret key for token authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend client URL
CLIENT_URL=http://localhost:5173

# Application Environment
NODE_ENV=development
