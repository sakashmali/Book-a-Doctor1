# PulseCare Project Root Environment Template
# Copy this file to server/.env when setting up the backend

PORT=5000

# MongoDB Atlas URI (Recommended for Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/book_a_doctor?retryWrites=true&w=majority

# Or Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/book_a_doctor

# JWT secret key for signing auth tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL
CLIENT_URL=http://localhost:5173

NODE_ENV=development
